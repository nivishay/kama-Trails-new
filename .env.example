# Supabase — copy to .env and fill in. NEVER commit real values (.env is gitignored).

# Server-only (privileged). Do not expose to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Client-exposed (browser + server). Publishable/anon key only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Public origin, used to build Cardcom redirect + webhook URLs. Prod: https://kamatrails.co.il
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cardcom payment provider — server-only. Sandbox creds in DECISIONS #29; prod = Vercel env swap.
# CARDCOM_API_PASSWORD authenticates the refund endpoint (Transactions/RefundByTransactionId); the
# admin cancel/refund flow (DECISIONS #15) fails loudly without it. Not needed by LowProfile checkout.
CARDCOM_TERMINAL_NUMBER=1000
CARDCOM_API_NAME=your_cardcom_api_name
CARDCOM_API_PASSWORD=your_cardcom_api_password

# WhatsApp Cloud API — server-only (DECISIONS #49/#50). Lead auto-reply. If unset, the send is
# skipped (lead still captured). Prod token must be a business-owned System-User token, not a
# personal/expiring one — see docs/pre-launch-checklist.md.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional overrides (defaults: lead_auto_reply / he / v21.0)
WHATSAPP_LEAD_TEMPLATE_NAME=lead_auto_reply
WHATSAPP_LEAD_TEMPLATE_LANG=he
WHATSAPP_API_VERSION=v21.0

# Cloudflare Turnstile — bot gate on the contact form (DECISIONS #51). If the secret is unset,
# verification is bypassed (dev only). Site key is browser-exposed; secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis — contact-form rate limiting (DECISIONS #51). If unset, rate limiting is disabled
# (dev only). Prod MUST set these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
