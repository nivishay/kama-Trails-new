# Preview sandbox — Supabase project `kama_trails_preview` (ref lvlmiiqfizmkoactmpxc).
# Isolated from production `kama_trails`; safe for the client to poke at.
# These values go into VERCEL → Settings → Environment Variables, scoped to PREVIEW ONLY
# (tick only the "Preview" box). Do NOT put them in local .env — that keeps them from
# colliding with your production keys. URL + publishable key are safe to commit here;
# SUPABASE_SECRET_KEY is NOT — copy it from the dashboard at deploy time and never commit it.

# Server-only (privileged). Do not expose to the browser.
SUPABASE_URL=https://lvlmiiqfizmkoactmpxc.supabase.co
# Copy from: Dashboard → project lvlmiiqfizmkoactmpxc → Settings → API Keys → sb_secret_...
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://lvlmiiqfizmkoactmpxc.supabase.co/auth/v1/.well-known/jwks.json

# Client-exposed (browser + server). Publishable/anon key only.
NEXT_PUBLIC_SUPABASE_URL=https://lvlmiiqfizmkoactmpxc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_1xHCPvn5uOto_mB2zF4CdQ_0b1An72x

# Public origin, used to build Cardcom redirect + webhook URLs.
# Set to the Vercel preview URL the client will use (a stable branch alias is best).
NEXT_PUBLIC_SITE_URL=https://kama-trails-git-preview-your-team.vercel.app

# Cardcom payment provider — server-only. Keep the SANDBOX creds here (never live terminal),
# so a client "playing" cannot move real money. Sandbox creds in DECISIONS #29.
CARDCOM_TERMINAL_NUMBER=1000
CARDCOM_API_NAME=your_cardcom_sandbox_api_name
CARDCOM_API_PASSWORD=your_cardcom_sandbox_api_password
